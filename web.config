<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <defaultDocument>
            <files>
                <add value="Index.php" />
            </files>
        </defaultDocument>
    </system.webServer>

    <!--
        Block direct browser requests to internal-only PHP files.

        These files are only ever meant to be reached server-side, via require/include
        from a real entry point (index.php, handler.php, match_webservice.php,
        team_webservice.php, troubleshoot.php). If one is requested directly by URL,
        PHP fails with a raw fatal error that discloses the full server file path
        (e.g. requesting modules/pdf/pdf_roster.php directly, since it references a
        framework interface that is only defined when loaded the normal way).

        This uses IIS's built-in Request Filtering (no extra module needed) to deny
        just the .php extension under these locations. Non-PHP static assets in the
        same folders (e.g. lib/misc_functions.js, lib/jquery.autocomplete-min.js)
        are a different extension and are completely unaffected.
    -->
    <location path="lib">
        <system.webServer>
            <security>
                <requestFiltering>
                    <fileExtensions>
                        <add fileExtension=".php" allowed="false" />
                    </fileExtensions>
                </requestFiltering>
            </security>
        </system.webServer>
    </location>
    <!--
        Exception to the lib/ block above: these two files are NOT internal-only includes -
        they are AJAX endpoints the random skill/stat roll generator calls directly via
        fetch() from the browser (see class_team_htmlout.php's "generate_random_skills" and
        stat-roll click handlers). The blanket lib/ .php deny correctly blocks direct access
        to real internal-only files, but it also silently blocked these two: IIS returned its
        own HTML error page instead of running the PHP, which broke the browser's
        JSON.parse() of the response ("Error generating skills/stat. Please try again.").
        A more specific <location> path inherits the broader "lib" location's fileExtensions
        collection, so re-adding ".php" here (even as allowed="true") is a duplicate key and
        IIS rejects the whole config with a 500.19 - must <clear/> the inherited entry instead,
        which removes the inherited deny and leaves .php allowed (the collection's default)
        for just these two files; everything else under lib/ stays blocked.
    -->
    <location path="lib/class_random_skills.php">
        <system.webServer>
            <security>
                <requestFiltering>
                    <fileExtensions>
                        <clear />
                    </fileExtensions>
                </requestFiltering>
            </security>
        </system.webServer>
    </location>
    <location path="lib/class_random_stat.php">
        <system.webServer>
            <security>
                <requestFiltering>
                    <fileExtensions>
                        <clear />
                    </fileExtensions>
                </requestFiltering>
            </security>
        </system.webServer>
    </location>
    <location path="modules">
        <system.webServer>
            <security>
                <requestFiltering>
                    <fileExtensions>
                        <add fileExtension=".php" allowed="false" />
                    </fileExtensions>
                </requestFiltering>
            </security>
        </system.webServer>
    </location>
    <location path="admin">
        <system.webServer>
            <security>
                <requestFiltering>
                    <fileExtensions>
                        <add fileExtension=".php" allowed="false" />
                    </fileExtensions>
                </requestFiltering>
            </security>
        </system.webServer>
    </location>

    <!--
        Same protection for the handful of root-level PHP files that are also
        internal-only (always require/include'd from header.php, never a URL
        entry point themselves) - notably settings.php, which holds the DB
        credentials.
    -->
    <location path="header.php">
        <system.webServer>
            <security>
                <requestFiltering>
                    <fileExtensions>
                        <add fileExtension=".php" allowed="false" />
                    </fileExtensions>
                </requestFiltering>
            </security>
        </system.webServer>
    </location>
    <location path="settings.php">
        <system.webServer>
            <security>
                <requestFiltering>
                    <fileExtensions>
                        <add fileExtension=".php" allowed="false" />
                    </fileExtensions>
                </requestFiltering>
            </security>
        </system.webServer>
    </location>
    <location path="settings_css.php">
        <system.webServer>
            <security>
                <requestFiltering>
                    <fileExtensions>
                        <add fileExtension=".php" allowed="false" />
                    </fileExtensions>
                </requestFiltering>
            </security>
        </system.webServer>
    </location>
    <location path="settings_modules.php">
        <system.webServer>
            <security>
                <requestFiltering>
                    <fileExtensions>
                        <add fileExtension=".php" allowed="false" />
                    </fileExtensions>
                </requestFiltering>
            </security>
        </system.webServer>
    </location>
    <location path="sections.php">
        <system.webServer>
            <security>
                <requestFiltering>
                    <fileExtensions>
                        <add fileExtension=".php" allowed="false" />
                    </fileExtensions>
                </requestFiltering>
            </security>
        </system.webServer>
    </location>
</configuration>
