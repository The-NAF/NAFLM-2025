<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <defaultDocument>
            <files>
                <add value="Index.php" />
            </files>
        </defaultDocument>
    </system.webServer>

    <!--
        Block direct browser requests to internal-only PHP files.

        These files are only ever meant to be reached server-side, via require/include
        from a real entry point (index.php, handler.php, match_webservice.php,
        team_webservice.php, troubleshoot.php). If one is requested directly by URL,
        PHP fails with a raw fatal error that discloses the full server file path
        (e.g. requesting modules/pdf/pdf_roster.php directly, since it references a
        framework interface that is only defined when loaded the normal way).

        This uses IIS's built-in Request Filtering (no extra module needed) to deny
        just the .php extension under these locations. Non-PHP static assets in the
        same folders (e.g. lib/misc_functions.js, lib/jquery.autocomplete-min.js)
        are a different extension and are completely unaffected.
    -->
    <location path="lib">
        <system.webServer>
            <security>
                <requestFiltering>
                    <fileExtensions>
                        <add fileExtension=".php" allowed="false" />
                    </fileExtensions>
                </requestFiltering>
            </security>
        </system.webServer>
    </location>
    <location path="modules">
        <system.webServer>
            <security>
                <requestFiltering>
                    <fileExtensions>
                        <add fileExtension=".php" allowed="false" />
                    </fileExtensions>
                </requestFiltering>
            </security>
        </system.webServer>
    </location>
    <location path="admin">
        <system.webServer>
            <security>
                <requestFiltering>
                    <fileExtensions>
                        <add fileExtension=".php" allowed="false" />
                    </fileExtensions>
                </requestFiltering>
            </security>
        </system.webServer>
    </location>

    <!--
        Same protection for the handful of root-level PHP files that are also
        internal-only (always require/include'd from header.php, never a URL
        entry point themselves) - notably settings.php, which holds the DB
        credentials.
    -->
    <location path="header.php">
        <system.webServer>
            <security>
                <requestFiltering>
                    <fileExtensions>
                        <add fileExtension=".php" allowed="false" />
                    </fileExtensions>
                </requestFiltering>
            </security>
        </system.webServer>
    </location>
    <location path="settings.php">
        <system.webServer>
            <security>
                <requestFiltering>
                    <fileExtensions>
                        <add fileExtension=".php" allowed="false" />
                    </fileExtensions>
                </requestFiltering>
            </security>
        </system.webServer>
    </location>
    <location path="settings_css.php">
        <system.webServer>
            <security>
                <requestFiltering>
                    <fileExtensions>
                        <add fileExtension=".php" allowed="false" />
                    </fileExtensions>
                </requestFiltering>
            </security>
        </system.webServer>
    </location>
    <location path="settings_modules.php">
        <system.webServer>
            <security>
                <requestFiltering>
                    <fileExtensions>
                        <add fileExtension=".php" allowed="false" />
                    </fileExtensions>
                </requestFiltering>
            </security>
        </system.webServer>
    </location>
    <location path="sections.php">
        <system.webServer>
            <security>
                <requestFiltering>
                    <fileExtensions>
                        <add fileExtension=".php" allowed="false" />
                    </fileExtensions>
                </requestFiltering>
            </security>
        </system.webServer>
    </location>
</configuration>
